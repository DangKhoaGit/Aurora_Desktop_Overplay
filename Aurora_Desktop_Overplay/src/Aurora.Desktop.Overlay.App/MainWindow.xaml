<Window x:Class="Aurora.Desktop.Overlay.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Aurora Desktop Overlay (ADO) — v0.2.0" Height="700" Width="1040" MinHeight="620" MinWidth="820" Icon="Assets/ADO_icon.png" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="WindowDrop">
 <Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal"><Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,14,0"><Image Source="Assets/ADO_icon.png" Margin="5"/></Border><StackPanel VerticalAlignment="Center"><TextBlock FontSize="25" FontWeight="SemiBold" Text="Aurora Desktop Overlay"/><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="Arrange images over your workspace"/></StackPanel></StackPanel>
   <Button x:Name="ThemeButton" Grid.Column="1" MinWidth="116" Height="40" Click="ToggleThemeClick" Content="☾  Dark mode" ToolTip="Switch between light and dark appearance"/>
  </Grid>
  <Border Grid.Row="1" Margin="0,22,0,18" Padding="12" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><WrapPanel>
   <Button MinWidth="112" Height="40" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" Click="OpenOverlayClick" Content="＋  Add image"/><Button MinWidth="112" Height="40" Margin="0,0,8,0" Click="PastePathClick" Content="Paste path"/><Button MinWidth="92" Height="40" Margin="0,0,8,0" Click="RenameClick" Content="Rename"/><Button MinWidth="100" Height="40" Margin="0,0,8,0" Click="DuplicateClick" Content="Duplicate"/><Button MinWidth="90" Height="40" Margin="0,0,8,0" Click="DeleteClick" Content="Delete"/><Button MinWidth="122" Height="40" Margin="0,0,8,0" Click="BringToFrontClick" Content="Bring to front"/><Button MinWidth="92" Height="40" Margin="0,0,8,0" Click="LockAllClick" Content="Lock all"/><Button x:Name="EditModeButton" MinWidth="104" Height="40" Click="ToggleEditModeClick" Content="Edit mode"/><CheckBox x:Name="StartupCheckBox" Margin="18,0,4,0" Content="Start with Windows" Click="StartupClick"/>
  </WrapPanel></Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <GroupBox Header="  ACTIVE OVERLAYS  "><ListBox x:Name="OverlayList" DisplayMemberPath="Name" SelectionChanged="OverlaySelectionChanged" AutomationProperties.Name="Active overlays"/></GroupBox>
   <GroupBox Grid.Column="2" Header="  SELECTED OVERLAY  "><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16,12" KeyboardNavigation.TabNavigation="Cycle">
    <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource MutedTextBrush}" Text="VISIBILITY &amp; INTERACTION" FontSize="12" FontWeight="SemiBold"/><WrapPanel Margin="0,0,0,4"><CheckBox x:Name="VisibleCheckBox" Width="120" Margin="0,0,0,12" Content="Visible" Click="VisibleClick"/><CheckBox x:Name="LockedCheckBox" Width="120" Margin="0,0,0,12" Content="Locked" Click="LockedClick"/><CheckBox x:Name="ClickThroughCheckBox" Width="120" Margin="0,0,0,12" Content="Click-through" Click="ClickThroughClick"/><CheckBox x:Name="TopmostCheckBox" Width="120" Margin="0,0,0,12" Content="Always on top" Click="TopmostClick"/></WrapPanel>
    <TextBlock Text="Opacity" FontWeight="SemiBold"/><Slider x:Name="OpacitySlider" Margin="0,7,0,3" Minimum="0" Maximum="1" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="OpacityChanged" AutomationProperties.Name="Overlay opacity"/><Separator Margin="0,17,0,14"/>
    <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource MutedTextBrush}" Text="ANIMATION" FontSize="12" FontWeight="SemiBold"/><CheckBox x:Name="PausedCheckBox" Margin="0,0,0,12" Content="Pause animation" Click="PlaybackChanged"/><TextBlock Text="Playback speed" FontWeight="SemiBold"/><ComboBox x:Name="PlaybackSpeedComboBox" Margin="0,6,0,14" SelectedValuePath="Tag" SelectionChanged="PlaybackSelectionChanged"><ComboBoxItem Content="0.5×" Tag="0.5"/><ComboBoxItem Content="1×" Tag="1" IsSelected="True"/><ComboBoxItem Content="2×" Tag="2"/></ComboBox><TextBlock Text="Animation FPS limit" FontWeight="SemiBold"/><Slider x:Name="FpsSlider" Margin="0,7,0,0" Minimum="1" Maximum="60" Value="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FpsChanged" AutomationProperties.Name="Animation FPS limit"/>
    <TextBlock x:Name="MonitorText" Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/><Button Margin="0,18,0,0" Height="40" HorizontalAlignment="Left" MinWidth="132" Click="ResetPositionClick" Content="Reset position"/><Border Margin="0,16,0,0" Padding="12" CornerRadius="8" Background="{DynamicResource SurfaceMutedBrush}"><TextBlock x:Name="DetailsText" TextWrapping="Wrap" Text="No overlay selected."/></Border>
   </StackPanel></ScrollViewer></GroupBox>
  </Grid>
  <Border Grid.Row="3" Margin="0,18,0,0" Padding="13,11" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9"><TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Add one or more images to begin." AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Application status"/></Border>
 </Grid>
</Window>
