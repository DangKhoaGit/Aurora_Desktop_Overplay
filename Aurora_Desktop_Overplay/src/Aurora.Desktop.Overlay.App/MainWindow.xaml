<Window x:Class="Aurora.Desktop.Overlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurora Desktop Overlay (ADO) — v0.1.0" Height="650" Width="900" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="WindowDrop">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock FontSize="28" FontWeight="SemiBold" Text="Aurora Desktop Overlay (ADO)" />
    <WrapPanel Grid.Row="1" Margin="0,14,0,14">
      <Button Width="110" Margin="0,0,8,0" Click="OpenOverlayClick" Content="_Add image" ToolTip="Import one or more images (Alt+A)" />
      <Button Width="110" Margin="0,0,8,0" Click="PastePathClick" Content="_Paste path" ToolTip="Import files or a path from the clipboard (Alt+P)" />
      <Button Width="110" Margin="0,0,8,0" Click="DuplicateClick" Content="D_uplicate" />
      <Button Width="110" Margin="0,0,8,0" Click="DeleteClick" Content="_Delete" />
      <Button Width="110" Margin="0,0,8,0" Click="BringToFrontClick" Content="_Bring to front" ToolTip="Change Z-order without focusing the overlay" />
      <Button Width="100" Margin="0,0,8,0" Click="LockAllClick" Content="_Lock all" />
      <Button x:Name="EditModeButton" Width="110" Click="ToggleEditModeClick" Content="_Edit mode" ToolTip="Temporarily disables click-through so overlays can be edited" />
      <CheckBox x:Name="StartupCheckBox" Margin="18,6,0,0" Content="Start with Windows"
                Click="StartupClick" />
    </WrapPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <GroupBox Header="Active overlays">
        <ListBox x:Name="OverlayList" DisplayMemberPath="Name" SelectionChanged="OverlaySelectionChanged"
                 AutomationProperties.Name="Active overlays" />
      </GroupBox>
      <GroupBox Grid.Column="2" Header="Selected overlay">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14" KeyboardNavigation.TabNavigation="Cycle">
          <CheckBox x:Name="VisibleCheckBox" Margin="0,0,0,10" Content="Visible" Click="VisibleClick" />
          <CheckBox x:Name="LockedCheckBox" Margin="0,0,0,10" Content="Locked" Click="LockedClick" />
          <CheckBox x:Name="ClickThroughCheckBox" Margin="0,0,0,10" Content="Click-through" Click="ClickThroughClick"
                    ToolTip="Lets mouse input pass to the application below the overlay" />
          <CheckBox x:Name="TopmostCheckBox" Margin="0,0,0,16" Content="Always on top" Click="TopmostClick" />
          <TextBlock Text="Opacity" FontWeight="SemiBold" />
          <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" Value="1" TickFrequency="0.1"
                  IsSnapToTickEnabled="True" ValueChanged="OpacityChanged" AutomationProperties.Name="Overlay opacity" />
          <Separator Margin="0,14,0,10" />
          <CheckBox x:Name="PausedCheckBox" Margin="0,0,0,10" Content="Pause animation" Click="PlaybackChanged" />
          <TextBlock Text="Playback speed" FontWeight="SemiBold" />
          <ComboBox x:Name="PlaybackSpeedComboBox" Margin="0,4,0,10" SelectedValuePath="Tag"
                    SelectionChanged="PlaybackSelectionChanged">
            <ComboBoxItem Content="0.5×" Tag="0.5" />
            <ComboBoxItem Content="1×" Tag="1" IsSelected="True" />
            <ComboBoxItem Content="2×" Tag="2" />
          </ComboBox>
          <TextBlock Text="Animation FPS limit" FontWeight="SemiBold" />
          <Slider x:Name="FpsSlider" Minimum="1" Maximum="60" Value="30" TickFrequency="1"
                  IsSnapToTickEnabled="True" ValueChanged="FpsChanged" AutomationProperties.Name="Animation FPS limit" />
          <TextBlock x:Name="MonitorText" Margin="0,8,0,0" />
          <Button Margin="0,18,0,0" Height="34" Click="ResetPositionClick" Content="Reset position" />
          <TextBlock x:Name="DetailsText" Margin="0,18,0,0" TextWrapping="Wrap" Text="No overlay selected." />
        </StackPanel>
        </ScrollViewer>
      </GroupBox>
    </Grid>
    <Border Grid.Row="3" Margin="0,14,0,0" Padding="10" Background="#FFF4F4F4" CornerRadius="4">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Add one or more images to begin."
                 AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Application status" />
    </Border>
  </Grid>
</Window>
